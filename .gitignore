# dated safe-file-ops holding folders (moved user files, never repo content)
Cleared */

# audition WAVs — 49MB of generated audio, rebuilt by tools/demo_sounds.py.
# Binary and regenerable, so it stays out of history (git can't diff it and
# never forgets it). Delete the folder and re-run that script to restore.
Sound Demos/

# Vox plugin build output — 148 MB of compiled artefacts (object files, a
# 27 MB juceaide binary, a 24 MB static library). Owner 2026-09-02: the Vox
# plugin is a separate project that landed here by accident. Build output is
# regenerated by cmake/ninja from vox_plugin/Source and JUCE, so nothing is
# lost by keeping it out of git. The files STAY on disk — this only stops
# git tracking them.
vox_plugin/build/

# Extracted Reason documentation — the owner's licensed manual, kept local.
# Regenerate with: python3 tools/reason_docs.py
reason_docs/

# Retired Reason 7 (2013) Help Files — superseded by the Reason 12.7 Operation
# Manual on 2026-09-10. Still the owner's licensed manual: stays local, never committed.
_retired_reason7_2026-09-10/

# Folders that are their own git repos (owner 2026-09-14). Committed here, git
# stores an empty pointer instead of their files, so they stay out. Files stay on disk.
sonic/
vox_plugin/JUCE/
.worktrees/
