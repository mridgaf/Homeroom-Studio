version={1,0,0}

function remote_supported_control_surfaces()
local surfaces =
{
{ manufacturer="ReasonVoice", model="ReasonVoice",
source="ReasonVoice.lua",
in_ports={{description="Input"}},
out_ports={{description="Output"}},
has_keyboard=false,
setup_info_text="Choose IAC Driver Bus 1 as the MIDI input. Output can be left unassigned. This surface receives commands from the Reason Voice speech app." },
}
return surfaces
end
