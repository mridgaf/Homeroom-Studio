/* Homeroom Studio blackboard theme, exactly as specified by the owner:
   background #111, text #eee, font "Blackboard Graffiti".
   Put Blackboard-Graffiti.woff2 in this same folder (reason_voice/static).
   To remove: delete the theme-chalkboard.css <link> line in index.html. */

@font-face {
  font-family: "Blackboard Graffiti";
  src: url("/static/Blackboard-Graffiti-Font-Traced/Blackboard-Graffiti.woff2") format("woff2"),
       url("/static/Blackboard-Graffiti-Font-Traced/Blackboard-Graffiti.woff") format("woff");
}

:root {
  --bg: #111;
  --panel: #111;
  --panel2: #1b1b1b;
  --line: #eeeeee33;
  --text: #eee;
  --dim: #eeeeeeaa;
  --accent: #eee;
  --accent-dim: #2b2b2b;
  --blue: #eee;
}

body {
  background: #111 !important;
  color: #eee;
  font-family: "Blackboard Graffiti", sans-serif;
}
body::before, body::after { display: none; }

header, aside, footer, .card, .modal, #docPanel {
  background: #111 !important;
  background-image: none !important;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  color: #eee;
}
.card, .modal { border: 1px solid #eeeeee44; }
button, input, select, textarea { font-family: "Blackboard Graffiti", sans-serif; color: #eee; }
button { background: #1b1b1b; }
.brand { color: #eee; font-family: "Blackboard Graffiti", sans-serif; }
ol.steps li.active { background: #2b2b2b; border-color: #eee; color: #eee; }
ol.steps li.active::before { background: #eee; color: #111; }
#walkbar { background: linear-gradient(transparent, #111 30%); }
.modal select { background: #111; color: #eee; }
#walkbar button:empty { display: none; }
